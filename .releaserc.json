{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "docs", "release": "patch" },
          { "type": "style", "release": "patch" },
          { "type": "test", "release": "patch" },
          { "type": "build", "release": "patch" },
          { "type": "ci", "release": "patch" },
          { "type": "chore", "release": "patch" }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "python3 scripts/release/stamp_version.py ${nextRelease.version} && ansible-galaxy collection build --force",
        "publishCmd": "if [ -n \"$GALAXY_API_KEY\" ]; then ansible-galaxy collection publish exadev-github_runner-${nextRelease.version}.tar.gz --api-key \"$GALAXY_API_KEY\"; else echo 'GALAXY_API_KEY is not set, skipping Ansible Galaxy publish.'; fi"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "galaxy.yml", "roles/github_runner_arc/defaults/main.yml"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "exadev-github_runner-${nextRelease.version}.tar.gz",
            "label": "Ansible collection tarball"
          }
        ]
      }
    ]
  ]
}
