# Generated by the exadev.github_runner collection's github_runner_cluster role on every run. Do not edit by hand: change this host's ansible/host_vars file and rerun ansible-playbook, or, on a host brought up with bootstrap.sh, change .env.bootstrap and rerun ./bootstrap.sh.
# The Compose files, as absolute paths, and the project the role runs this node with, so that a docker compose command run by hand in this directory, or with --project-directory from another, acts on the same project with the same files (each command still needs its --profile, and the host's pinned Docker context when it has one).
COMPOSE_FILE={{ github_runner_cluster_compose_file_list | map('regex_replace', '^(?!/)', github_runner_cluster_dir ~ '/') | join(':') }}
COMPOSE_PROJECT_NAME={{ github_runner_cluster_compose_project }}
K3S_CONTAINER_NAME={{ github_runner_cluster_container_name }}
K3S_API_PORT={{ github_runner_cluster_api_port }}
K3S_TOKEN={{ github_runner_cluster_k3s_token }}
K3S_VERSION={{ github_runner_cluster_k3s_version }}
TAILSCALE_VERSION={{ github_runner_cluster_tailscale_version }}
K3S_TLS_SAN_LIST={{ github_runner_cluster_effective_tls_sans | join(' ') }}
K3S_VPN_AUTH_JOIN_KEY={{ github_runner_cluster_mesh_join_key }}
{% if github_runner_cluster_mesh_control_server_url | length > 0 %}
K3S_VPN_AUTH_CONTROL_SERVER_URL={{ github_runner_cluster_mesh_control_server_url }}
{% endif %}
K3S_JOIN_SERVER_URL={{ github_runner_cluster_effective_server_url }}
{% if github_runner_cluster_datastore == 'sqlite' %}
K3S_DATASTORE=sqlite
{% endif %}
K3S_NODE_NAME={{ github_runner_cluster_effective_node_name }}
{% if github_runner_cluster_node_taints | length > 0 %}
K3S_NODE_TAINTS={{ github_runner_cluster_node_taints | join(' ') }}
{% endif %}
{% if github_runner_cluster_etcd_heartbeat_interval | string | length > 0 %}
K3S_ETCD_HEARTBEAT_INTERVAL={{ github_runner_cluster_etcd_heartbeat_interval }}
K3S_ETCD_ELECTION_TIMEOUT={{ github_runner_cluster_etcd_election_timeout }}
{% endif %}
