# Generated by the exadev.github_runner collection's github_runner_cluster role on every run. Do not edit by hand: change this host's ansible/host_vars file and rerun ansible-playbook. Read by the role actuator (files/role/fleet-role-actuator.sh), by its watcher unit and by the role's own promotion and demotion of this host; see the role README's Role actuator. It holds no secret: the actuator's credential is in its kubeconfig, which only root reads.
FLEET_ROLE_ACTUATOR=systemd
NODE_NAME={{ github_runner_cluster_effective_node_name }}
ROLE_FILE={{ github_runner_cluster_native_role_file }}
K3S_SERVICE={{ github_runner_cluster_native_server_service }}
K3S_AGENT_SERVICE={{ github_runner_cluster_native_agent_service }}
REGRADE_SERVICE={{ github_runner_cluster_native_regrade_service }}
K3S_DATA_DIR={{ github_runner_cluster_native_data_dir }}
CONFIG_DIR={{ github_runner_cluster_native_config_dir }}
UNIT_DIR={{ github_runner_cluster_native_unit_dir }}
LEVEL_FILE={{ github_runner_cluster_native_regrade_level_file }}
STARTED_FILE={{ github_runner_cluster_native_regrade_started_file }}
{# A step's waits (a restart into etcd-only, the switch lock) are bounded by regrading's, which they are made of. #}
OPERATION_TIMEOUT_SECONDS={{ github_runner_cluster_regrade_operation_timeout_seconds }}
API_PORT={{ github_runner_cluster_api_port }}
LEASE_NAMESPACE={{ github_runner_cluster_regrade_lease_namespace }}
LEASE_NAME={{ github_runner_cluster_regrade_lease_name }}
ROLE_LEASE_HOLDER={{ github_runner_cluster_role_lease_holder }}
SWAP_ID_ANNOTATION={{ github_runner_cluster_role_lease_swap_id_annotation }}
ACTUATOR_NAMESPACE={{ github_runner_cluster_role_actuator_namespace }}
ACTUATOR_CONFIGMAP={{ github_runner_cluster_role_actuator_configmap }}
JOIN_URLS_FILE={{ github_runner_cluster_role_actuator_dir }}/join-urls
KUBECTL="{{ github_runner_cluster_native_bin_dir }}/k3s kubectl"
KUBECONFIG_PATH={{ github_runner_cluster_role_actuator_kubeconfig }}
{# The API servers the actuator reaches the cluster through: never this host's own, which a server stepped down to etcd-only does not have and an agent never has. #}
KUBE_SERVERS="{% for candidate in github_runner_cluster_api_candidates %}{{ ' ' if not loop.first else '' }}https://{{ candidate.value.address }}:{{ github_runner_cluster_api_port }}{% endfor %}"
