# Generated by the exadev.github_runner collection's github_runner_cluster role on every run. Do not edit by hand: change this host's ansible/host_vars file and rerun ansible-playbook. Read by the role actuator (files/role/fleet-role-actuator.sh), by its watcher (a native host's unit, a Docker host's role-actuator service) and, on a native host, by the role's own promotion and demotion; see the role README's Role actuator. It holds no secret: the actuator's credential is in its kubeconfig, which only root, or on a Docker host the connecting user and the service's container, reads.
{% if github_runner_cluster_node_mode == 'native' %}
FLEET_ROLE_ACTUATOR=systemd
ROLE_FILE={{ github_runner_cluster_native_role_file }}
K3S_SERVICE={{ github_runner_cluster_native_server_service }}
K3S_AGENT_SERVICE={{ github_runner_cluster_native_agent_service }}
REGRADE_SERVICE={{ github_runner_cluster_native_regrade_service }}
K3S_DATA_DIR={{ github_runner_cluster_native_data_dir }}
CONFIG_DIR={{ github_runner_cluster_native_config_dir }}
UNIT_DIR={{ github_runner_cluster_native_unit_dir }}
LEVEL_FILE={{ github_runner_cluster_native_regrade_level_file }}
STARTED_FILE={{ github_runner_cluster_native_regrade_started_file }}
{% else %}
{# A Docker host's: the paths are those of the role-actuator service's container, which mounts the project directory at its own path and the server's k3s data volume where the server's container mounts it (templates/docker-compose.role-actuator.yml.j2), so LEVEL_FILE and STARTED_FILE are fleet-regrade-docker.sh's own. #}
FLEET_ROLE_ACTUATOR=docker
PROJECT_DIR={{ github_runner_cluster_dir }}
COMPOSE_PROJECT={{ github_runner_cluster_compose_project }}
COMPOSE_FILES="{{ github_runner_cluster_compose_files_in_use | join(' ') }}"
ROLE_DIR={{ github_runner_cluster_dir }}/fleet-role.d
STATE_DIR={{ github_runner_cluster_role_actuator_dir }}
SERVER_CONTAINER={{ github_runner_cluster_container_name }}
AGENT_CONTAINER={{ github_runner_cluster_agent_container_name }}
NODE_CONTAINER={{ github_runner_cluster_container_name }}
REGRADE_CONTAINER={{ github_runner_cluster_compose_project }}-regrade-1
K3S_DATA_DIR=/var/lib/rancher/k3s
{% endif %}
NODE_NAME={{ github_runner_cluster_effective_node_name }}
{# A step's waits (a restart into etcd-only, the switch lock) are bounded by regrading's, which they are made of. #}
OPERATION_TIMEOUT_SECONDS={{ github_runner_cluster_regrade_operation_timeout_seconds }}
API_PORT={{ github_runner_cluster_api_port }}
LEASE_NAMESPACE={{ github_runner_cluster_regrade_lease_namespace }}
LEASE_NAME={{ github_runner_cluster_regrade_lease_name }}
ROLE_LEASE_HOLDER={{ github_runner_cluster_role_lease_holder }}
SWAP_ID_ANNOTATION={{ github_runner_cluster_role_lease_swap_id_annotation }}
ACTUATOR_NAMESPACE={{ github_runner_cluster_role_actuator_namespace }}
ACTUATOR_CONFIGMAP={{ github_runner_cluster_role_actuator_configmap }}
JOIN_URLS_FILE={{ github_runner_cluster_role_actuator_dir }}/join-urls
{# On a Docker host, the kubectl of whichever node container is up, since only those are on the tailnet (node_kubectl in files/role/fleet-role-actuator-docker.sh). #}
KUBECTL={{ ('"' ~ github_runner_cluster_native_bin_dir ~ '/k3s kubectl"') if github_runner_cluster_node_mode == 'native' else 'node_kubectl' }}
KUBECONFIG_PATH={{ github_runner_cluster_role_actuator_kubeconfig }}
{# The API servers the actuator reaches the cluster through: never this host's own, which a server stepped down to etcd-only does not have and an agent never has. #}
KUBE_SERVERS="{% for candidate in github_runner_cluster_api_candidates %}{{ ' ' if not loop.first else '' }}https://{{ candidate.value.address }}:{{ github_runner_cluster_api_port }}{% endfor %}"
