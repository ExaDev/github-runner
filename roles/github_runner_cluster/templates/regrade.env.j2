# Generated by the exadev.github_runner collection's github_runner_cluster role on every run. Do not edit by hand: change this host's ansible/host_vars file and rerun ansible-playbook. Read by the regrade service (docker-compose.yml, regrade/); see the role README's Memory-pressure regrading.
PRESSURE_THRESHOLD={{ github_runner_cluster_regrade_pressure_threshold }}
AVAILABLE_FLOOR_PERCENT={{ github_runner_cluster_regrade_available_floor_percent }}
SAMPLE_SECONDS={{ github_runner_cluster_regrade_sample_seconds }}
SUSTAIN_SECONDS={{ github_runner_cluster_regrade_sustain_seconds }}
COOLDOWN_SECONDS={{ github_runner_cluster_regrade_cooldown_seconds }}
OPERATION_TIMEOUT_SECONDS={{ github_runner_cluster_regrade_operation_timeout_seconds }}
LEASE_DURATION_SECONDS={{ github_runner_cluster_regrade_lease_duration_seconds }}
STEP_UP={{ github_runner_cluster_regrade_step_up }}
NODE_NAME={{ github_runner_cluster_effective_node_name }}
FLEET_REGRADE_ACTUATOR=docker
NODE_CONTAINER={{ github_runner_cluster_node_container }}
CONTROL_PLANE_TAINT={{ github_runner_cluster_regrade_taint }}
LEVEL_LABEL={{ github_runner_cluster_regrade_level_label }}
KUBECTL="docker exec -i {{ github_runner_cluster_node_container }} kubectl"
KUBECONFIG_PATH=/etc/rancher/k3s/k3s.yaml
{# The API servers the service may reach the cluster through, never this one's: at etcd-only this server has none, and its own answers "apiserver disabled" on some servers. Every other server, then every other host that may become one (github_runner_cluster_voter_eligible), each in inventory order and by the address the servers' certificates carry; the core uses the first whose /readyz answers, since the servers can change at run time. #}
{% set github_runner_cluster_regrade_others = github_runner_cluster_topology.hosts | dict2items | rejectattr('key', 'equalto', inventory_hostname) | list %}
{% set github_runner_cluster_regrade_candidates = (github_runner_cluster_regrade_others | selectattr('value.role', 'equalto', 'server') | list)
     + (github_runner_cluster_regrade_others | rejectattr('value.role', 'equalto', 'server') | selectattr('value.eligible') | list) %}
KUBE_SERVERS="{% for candidate in github_runner_cluster_regrade_candidates %}{{ ' ' if not loop.first else '' }}https://{{ candidate.value.address }}:{{ github_runner_cluster_api_port }}{% endfor %}"
