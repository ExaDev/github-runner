# Generated by the exadev.github_runner collection's github_runner_cluster role on a Docker host the role controller may switch (github_runner_cluster_role_controller: true, on a server or a host marked github_runner_cluster_voter_eligible). Do not edit by hand. Merged after docker-compose.yml only by the role's own Compose command for this service (tasks/role_actuator_docker.yml), never by the k3s services' commands, so a host the controller never moves keeps the Compose configuration it has. A template rather than a file of the collection, because the project directory is mounted at its own absolute path, which only the role knows: the paths a Compose command run in this container passes the daemon (the k3s build context, the entrypoint and role directory bind mounts) are then the host's.
services:
  # The role actuator (files/role/fleet-role-actuator.sh with files/role/fleet-role-actuator-docker.sh), which switches this host between its k3s and k3s-agent services when the role controller asks through the host's Node; see the role README's Role actuator. It needs the Docker socket to stop, start and copy between the node containers, the same permission cost as the regrade and docker-prune services, and the server's k3s data volume, at the path the server mounts it, for the datastore it moves aside and the regrading level it forgets.
  role-actuator:
    build:
      context: ./role
    restart: unless-stopped
    profiles: ["role-actuator"]
    entrypoint: [{{ (github_runner_cluster_role_actuator_dir ~ '/fleet-role-actuator.sh') | to_json }}]
    command: ["watch"]
    environment:
      - {{ ('FLEET_ROLE_ACTUATOR_ENV=' ~ github_runner_cluster_role_actuator_dir ~ '/fleet-role-actuator.env') | to_json }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ (github_runner_cluster_dir ~ ':' ~ github_runner_cluster_dir) | to_json }}
      - k3s-data:/var/lib/rancher/k3s
