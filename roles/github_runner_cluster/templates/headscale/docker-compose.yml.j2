# Generated by the github_runner_cluster Ansible role (headscale_hosted mesh provider) on every run. Do not edit by hand: change the role's github_runner_cluster_headscale_* variables and rerun.
{% set litestream = github_runner_cluster_headscale_litestream | bool %}
{% set standby = github_runner_cluster_headscale_as_standby | bool %}
{% if standby %}
# The warm standby: only litestream-follow runs. Everything under the active profile starts when playbooks/promote_headscale_standby.yml promotes this host.
{% endif %}
name: {{ github_runner_cluster_headscale_project }}
services:
  headscale:
    image: docker.io/headscale/headscale:v{{ github_runner_cluster_headscale_version }}
    container_name: {{ github_runner_cluster_headscale_project }}
    command: ["serve"]
    restart: unless-stopped
{% if standby %}
    profiles: [active]
{% endif %}
{% if litestream %}
    # Started after, and so stopped before, the sidecar, which then copies Headscale's last writes on its way down.
    depends_on:
      litestream:
        condition: service_started
{% endif %}
    ports:
      - "{{ github_runner_cluster_headscale_listen_port }}:{{ github_runner_cluster_headscale_listen_port }}"
{% if github_runner_cluster_headscale_derp == 'embedded' %}
      - "3478:3478/udp"
{% endif %}
    volumes:
      - ./config:/etc/headscale:ro
      - headscale-state:/var/lib/headscale
    healthcheck:
      test: ["CMD", "headscale", "health"]
      interval: 10s
      timeout: 5s
      retries: 3
{% if litestream %}
{% set litestream_volumes = ['headscale-state:/var/lib/headscale', './litestream:/etc/github-runner-litestream:ro', './keys:/etc/github-runner-headscale-keys:ro'] + (github_runner_cluster_headscale_litestream_mounts | map('regex_replace', '^(.*)$', '\\1:\\1')) | list %}
  litestream-restore:
    image: docker.io/litestream/litestream:{{ github_runner_cluster_headscale_litestream_version }}
    entrypoint: ["/bin/sh", "/etc/github-runner-litestream/litestream.sh", "restore"]
    restart: "no"
{% if standby %}
    profiles: [active]
{% endif %}
    volumes: {{ litestream_volumes | to_json }}
  litestream:
    image: docker.io/litestream/litestream:{{ github_runner_cluster_headscale_litestream_version }}
    entrypoint: ["/bin/sh", "/etc/github-runner-litestream/litestream.sh", "replicate"]
    restart: unless-stopped
{% if standby %}
    profiles: [active]
{% endif %}
    depends_on:
      litestream-restore:
        condition: service_completed_successfully
    volumes: {{ litestream_volumes | to_json }}
{% if standby %}
  litestream-follow:
    image: docker.io/litestream/litestream:{{ github_runner_cluster_headscale_litestream_version }}
    entrypoint: ["/bin/sh", "/etc/github-runner-litestream/litestream.sh", "follow"]
    restart: unless-stopped
    volumes: {{ (litestream_volumes + ['headscale-standby:/var/lib/headscale-standby']) | to_json }}
{% endif %}
{% endif %}
volumes:
  headscale-state: {}
{% if litestream and standby %}
  headscale-standby: {}
{% endif %}
