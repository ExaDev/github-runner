# Generated by the github_runner_cluster Ansible role ({{ github_runner_cluster_mesh }} mesh provider) on every run. Do not edit by hand: change the role's github_runner_cluster_headscale_* variables and rerun.
server_url: {{ github_runner_cluster_headscale_url }}
listen_addr: 0.0.0.0:{{ github_runner_cluster_headscale_listen_port }}
# Loopback only: nothing off the server's own host needs metrics.
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false
noise:
  private_key_path: /var/lib/headscale/noise_private.key
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential
derp:
  server:
    enabled: {{ github_runner_cluster_headscale_derp == 'embedded' }}
    region_id: 999
    region_code: headscale
    region_name: Headscale Embedded DERP
    verify_clients: true
    stun_listen_addr: 0.0.0.0:3478
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  auto_update_enabled: true
  update_frequency: 3h
disable_check_updates: true
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
{% if github_runner_cluster_headscale_tls == 'letsencrypt' %}
acme_url: https://acme-v02.api.letsencrypt.org/directory
acme_email: "{{ github_runner_cluster_headscale_acme_email }}"
tls_letsencrypt_hostname: {{ github_runner_cluster_headscale_url | urlsplit('hostname') }}
tls_letsencrypt_cache_dir: /var/lib/headscale/cache
# TLS-ALPN-01 answers the challenge on the HTTPS port itself, so nothing needs port 80.
tls_letsencrypt_challenge_type: TLS-ALPN-01
{% endif %}
log:
  level: info
  format: text
policy:
  mode: file
  path: /etc/headscale/policy.hujson
dns:
  magic_dns: true
  # Node addresses are <node name>.<this domain> (github_runner_cluster_tailnet_domain), the names the k3s join URL and TLS SANs use.
  base_domain: {{ github_runner_cluster_tailnet_domain }}
  override_local_dns: {{ github_runner_cluster_headscale_nameservers | length > 0 }}
  nameservers:
    global: {{ github_runner_cluster_headscale_nameservers | to_json }}
unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"
logtail:
  enabled: false
