# Generated by the github_runner_cluster Ansible role (headscale_in_cluster mesh provider) on every run, for the bootstrap server only. Do not edit by hand. Merged after docker-compose.yml: publishes Headscale's port, which the Headscale static pod serves inside the k3s container, gives that pod its configuration and manifest, and has k3s/node-entrypoint.sh supervise k3s until Headscale answers.
services:
  k3s:
    ports:
      - "{{ github_runner_cluster_headscale_listen_port }}:{{ github_runner_cluster_headscale_listen_port }}"
{% if github_runner_cluster_headscale_derp == 'embedded' %}
      - "3478:3478/udp"
{% endif %}
    environment:
      K3S_MESH_SELF_HOSTED_HEALTH_URL: http://127.0.0.1:9090/metrics
    volumes:
      - {{ github_runner_cluster_headscale_host_dir }}/config:/etc/github-runner-headscale:ro
      - {{ github_runner_cluster_headscale_host_dir }}/manifests:/var/lib/rancher/k3s/agent/pod-manifests:ro
