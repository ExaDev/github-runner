# Managed by the exadev.github_runner collection's github_runner_linux_host role. Do not edit by hand: change this host's variables and run the role again.
[Unit]
Description=Limit the {{ github_runner_linux_host_battery_device }} charge to {{ github_runner_linux_host_battery_charge_limit_percent }} percent
# The attribute exists once the battery has been registered. After the udev trigger so that the coldplugged devices are in place, and skipped, not failed, on a host that has no such file.
After=systemd-udev-trigger.service
ConditionPathExists={{ github_runner_linux_host_power_supply_dir }}/{{ github_runner_linux_host_battery_device }}/charge_control_end_threshold

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo {{ github_runner_linux_host_battery_charge_limit_percent }} > {{ github_runner_linux_host_power_supply_dir }}/{{ github_runner_linux_host_battery_device }}/charge_control_end_threshold'

[Install]
WantedBy=multi-user.target
