{# The pull Secret renewal for one scale-set profile (see tasks/install_pull_secret_renewal.yml): a ServiceAccount, a Role that may only get and patch the pull Secret, its RoleBinding, and the CronJob running scripts/renew-pull-secret.sh. `org` and `profile` are set by the including task. #}
{% set name = github_runner_arc_image_pull_secret_name ~ '-renewer' %}
{% set labels = {'app.kubernetes.io/name': 'pull-secret-renewer', 'app.kubernetes.io/part-of': 'github-runner'} %}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ name | to_json }}
  namespace: {{ profile.namespace | to_json }}
  labels: {{ labels | to_json }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ name | to_json }}
  namespace: {{ profile.namespace | to_json }}
  labels: {{ labels | to_json }}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: [{{ github_runner_arc_image_pull_secret_name | to_json }}]
    verbs: ["get", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ name | to_json }}
  namespace: {{ profile.namespace | to_json }}
  labels: {{ labels | to_json }}
subjects:
  - kind: ServiceAccount
    name: {{ name | to_json }}
    namespace: {{ profile.namespace | to_json }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ name | to_json }}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ name | to_json }}
  namespace: {{ profile.namespace | to_json }}
  labels: {{ labels | to_json }}
spec:
  schedule: {{ github_runner_arc_image_pull_secret_renewal_schedule | to_json }}
  # One renewal at a time; a run that misses its slot by more than this is skipped rather than run late, and the next one renews instead.
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 300
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 2
      activeDeadlineSeconds: 300
      template:
        metadata:
          labels: {{ labels | to_json }}
        spec:
          serviceAccountName: {{ name | to_json }}
          restartPolicy: Never
{% if github_runner_arc_node_label_key | length > 0 %}
          nodeSelector: {{ {github_runner_arc_node_label_key: github_runner_arc_node_label_value | string} | to_json }}
{% endif %}
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
            # Makes the mounted App Secret readable by that group, and by nobody else.
            fsGroup: 65532
            seccompProfile:
              type: RuntimeDefault
          containers:
            - name: renew
              image: {{ github_runner_arc_image_pull_secret_renewer_image | to_json }}
              env:
                - name: PULL_SECRET_NAME
                  value: {{ github_runner_arc_image_pull_secret_name | to_json }}
                - name: PULL_SECRET_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: PULL_REGISTRY
                  value: {{ github_runner_arc_image_pull_registry | to_json }}
                - name: VERIFY_IMAGES
                  value: {{ (([org.image] | map('exadev.github_runner.arc_image_ref') | selectattr('registry', 'equalto', github_runner_arc_image_pull_registry) | list) if github_runner_arc_verify_image_pull | bool else []) | to_json | to_json }}
                - name: EXPIRY_ANNOTATION
                  value: {{ github_runner_arc_pull_token_expiry_annotation | to_json }}
                - name: FIELD_MANAGER
                  value: {{ github_runner_arc_pull_secret_field_manager | to_json }}
                - name: GITHUB_APP_DIR
                  value: /var/run/github-app
                # kubectl's cache and the script's working files go to the in-memory volume, since the root filesystem is read-only.
                - name: HOME
                  value: /tmp
                - name: TMPDIR
                  value: /tmp
              securityContext:
                allowPrivilegeEscalation: false
                readOnlyRootFilesystem: true
                capabilities:
                  drop: ["ALL"]
              resources:
                requests:
                  cpu: 10m
                  memory: 32Mi
                limits:
                  cpu: 200m
                  memory: 64Mi
              volumeMounts:
                - name: github-app
                  mountPath: /var/run/github-app
                  readOnly: true
                - name: tmp
                  mountPath: /tmp
          volumes:
            - name: github-app
              secret:
                secretName: {{ profile.app_secret | to_json }}
                # 0440: owner and group read.
                defaultMode: 288
            - name: tmp
              emptyDir:
                medium: Memory
                sizeLimit: 8Mi
