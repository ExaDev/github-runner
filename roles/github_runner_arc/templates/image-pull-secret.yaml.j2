{# The registry pull Secret written into each namespace that pulls a private image. The including task passes `namespace`, the credential as `username` and `password`, and `annotations` (empty for a static credential; an App token's expiry otherwise). #}
apiVersion: v1
kind: Secret
type: kubernetes.io/dockerconfigjson
metadata:
  name: {{ github_runner_arc_image_pull_secret_name | to_json }}
  namespace: {{ namespace | to_json }}
{% if annotations %}
  annotations: {{ annotations | to_json }}
{% endif %}
data:
  .dockerconfigjson: {{ ({'auths': {github_runner_arc_image_pull_registry: {'username': username, 'password': password, 'auth': (username ~ ':' ~ password) | b64encode}}}) | to_json | b64encode | to_json }}
