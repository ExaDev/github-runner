{# The node cache pruner (see tasks/install_node_cache_pruner.yml): a ServiceAccount, a Role and RoleBinding in each fleet profile's namespace (so the pruner can list the pods it must not prune under, including those of a profile whose cache capability was removed while its directory remains, and nothing wider), and the DaemonSet. `github_runner_arc_fleet` is the fleet's expanded profiles and `github_runner_arc_node_cache_profiles` those with a node cache. #}
{% set name = 'node-cache-pruner' %}
{% set labels = github_runner_arc_node_cache_pruner_labels %}
{% set platform = github_runner_arc_platform_namespace %}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ name | to_json }}
  namespace: {{ platform | to_json }}
  labels: {{ labels | to_json }}
{% for profile in github_runner_arc_fleet.profiles %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ (name ~ '-' ~ profile.release) | to_json }}
  namespace: {{ profile.namespace | to_json }}
  labels: {{ labels | to_json }}
rules:
  # list, to see whether a runner pod of this profile runs on the pruner's node. Nothing else.
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ (name ~ '-' ~ profile.release) | to_json }}
  namespace: {{ profile.namespace | to_json }}
  labels: {{ labels | to_json }}
subjects:
  - kind: ServiceAccount
    name: {{ name | to_json }}
    namespace: {{ platform | to_json }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ (name ~ '-' ~ profile.release) | to_json }}
{% endfor %}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: {{ name | to_json }}
  namespace: {{ platform | to_json }}
  labels: {{ labels | to_json }}
spec:
  selector:
    matchLabels:
      app: {{ name | to_json }}
  template:
    metadata:
      labels:
        app: {{ name | to_json }}
    spec:
      serviceAccountName: {{ name | to_json }}
      priorityClassName: {{ github_runner_arc_platform_priority_class_name | to_json }}
      imagePullSecrets: {{ github_runner_arc_platform_image_pull_secrets | to_json }}
      # Only the nodes runner pods may use, and every taint they carry tolerated, so the pruner reaches each cache wherever the pods go.
      nodeSelector: {{ {github_runner_arc_node_label_key: github_runner_arc_node_label_value | string} | to_json }}
      tolerations:
        - operator: Exists
      containers:
        - name: {{ name | to_json }}
          image: {{ github_runner_arc_autoscaler_image | to_json }}
          command: ["/app/scripts/node-cache-pruner.sh"]
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: LIMIT_GIB
              value: {{ github_runner_arc_node_cache_size_limit_gib | string | to_json }}
            - name: HARD_LIMIT_FACTOR
              value: {{ github_runner_arc_node_cache_hard_limit_factor | string | to_json }}
            - name: HOST_CACHE_ROOT
              value: {{ github_runner_arc_node_cache_host_path | exadev.github_runner.arc_node_cache_root | to_json }}
            - name: CHECK_SECONDS
              value: {{ github_runner_arc_node_cache_prune_seconds | string | to_json }}
            - name: WANTED_CACHES
              value: {{ (github_runner_arc_node_cache_profiles | map(attribute='target') | list | join(' ')) | to_json }}
            # kubectl writes its cache under HOME, and the root filesystem is read-only.
            - name: HOME
              value: /tmp
          # Root, because the files it removes belong to the runner's user: DAC_OVERRIDE to delete in directories it does not own, and FOWNER to delete from a directory with the sticky bit that a job made; nothing else.
          securityContext:
            runAsUser: 0
            runAsNonRoot: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
              add: ["DAC_OVERRIDE", "FOWNER"]
          volumeMounts:
            - name: node-cache
              mountPath: /host-node-cache
            - name: tmp
              mountPath: /tmp
          resources:
            requests:
              cpu: "10m"
              memory: "16Mi"
              ephemeral-storage: {{ github_runner_arc_platform_ephemeral_storage_request | to_json }}
            limits:
              cpu: "200m"
              memory: "64Mi"
              ephemeral-storage: {{ github_runner_arc_platform_ephemeral_storage_limit | to_json }}
      volumes:
        - name: node-cache
          hostPath:
            path: {{ github_runner_arc_node_cache_host_path | exadev.github_runner.arc_node_cache_root | to_json }}
            type: DirectoryOrCreate
        - name: tmp
          emptyDir: {}
