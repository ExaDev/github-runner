{# The role controller (see tasks/install_fleet_role.yml, scripts/fleet-role.sh and scripts/fleet-role-probe.sh): the controller's ServiceAccount, ClusterRole, binding, ConfigMap Role and Deployment, and the probe's own, with its DaemonSet. The namespace is ensured, and the two ConfigMaps are created, separately, since applying an empty ConfigMap again would wipe what the controller and the probes have published. #}
{% set controller = 'fleet-role' %}
{% set probe = 'fleet-role-probe' %}
{% set labels = {'app.kubernetes.io/part-of': 'github-runner'} %}
{% set namespace = github_runner_arc_platform_namespace %}
{% set probe_configmap = github_runner_arc_role_controller_probe_configmap %}
{% set status_configmap = github_runner_arc_role_controller_status_configmap %}
{# A ClusterRole can only name nodes cluster-wide; the controller and the probe both list them to find the voters and the standbys, and neither can write one. #}
{% set node_rules = [{'apiGroups': [''], 'resources': ['nodes'], 'verbs': ['get', 'list']}] %}
{% for name in [controller, probe] %}
{% set own_labels = labels | combine({'app.kubernetes.io/name': name}) %}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ name | to_json }}
  namespace: {{ namespace | to_json }}
  labels: {{ own_labels | to_json }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ ('github-runner-' ~ name) | to_json }}
  labels: {{ own_labels | to_json }}
rules: {{ node_rules | to_json }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ ('github-runner-' ~ name) | to_json }}
  labels: {{ own_labels | to_json }}
subjects:
  - kind: ServiceAccount
    name: {{ name | to_json }}
    namespace: {{ namespace | to_json }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ ('github-runner-' ~ name) | to_json }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ name | to_json }}
  namespace: {{ namespace | to_json }}
  labels: {{ own_labels | to_json }}
{# Scoped by resourceNames to the objects each touches. Neither is granted create, so a deleted ConfigMap fails loudly and the next run of the role makes it again, as the autoscaler's status ConfigMap does. #}
rules:
{% if name == controller %}
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: {{ [probe_configmap] | to_json }}
    verbs: ["get"]
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: {{ [status_configmap] | to_json }}
    verbs: ["get", "patch"]
{% else %}
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: {{ [probe_configmap] | to_json }}
    verbs: ["get", "patch"]
{% endif %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ name | to_json }}
  namespace: {{ namespace | to_json }}
  labels: {{ own_labels | to_json }}
subjects:
  - kind: ServiceAccount
    name: {{ name | to_json }}
    namespace: {{ namespace | to_json }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ name | to_json }}
---
{% endfor %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ controller | to_json }}
  namespace: {{ namespace | to_json }}
  labels: {{ (labels | combine({'app.kubernetes.io/name': controller})) | to_json }}
spec:
  replicas: 1
  selector:
    matchLabels: {{ {'app.kubernetes.io/name': controller} | to_json }}
  template:
    metadata:
      labels: {{ (labels | combine({'app.kubernetes.io/name': controller})) | to_json }}
    spec:
      serviceAccountName: {{ controller | to_json }}
      priorityClassName: {{ github_runner_arc_platform_priority_class_name | to_json }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: {{ controller | to_json }}
          image: {{ github_runner_arc_role_controller_image | to_json }}
          env:
            # The controller reports and changes nothing; the script refuses any other value.
            - name: FLEET_ROLE_DRY_RUN
              value: "true"
            - name: FLEET_ROLE_VOTERS
              value: {{ github_runner_arc_role_controller_voters | string | to_json }}
            - name: FLEET_ROLE_MAX_SERVERS
              value: {{ github_runner_arc_role_controller_max_servers | string | to_json }}
            - name: FLEET_ROLE_ELECTION_TIMEOUT_MS
              value: {{ github_runner_arc_role_controller_election_timeout_ms | string | to_json }}
            - name: FLEET_ROLE_SAMPLE_SECONDS
              value: {{ github_runner_arc_role_controller_sample_seconds | string | to_json }}
            - name: FLEET_ROLE_PRESSURE_THRESHOLD
              value: {{ github_runner_arc_role_controller_pressure_threshold | string | to_json }}
            - name: FLEET_ROLE_AVAILABLE_FLOOR_PERCENT
              value: {{ github_runner_arc_role_controller_available_floor_percent | string | to_json }}
            - name: FLEET_ROLE_ELIGIBLE_LABEL
              value: {{ github_runner_arc_role_controller_eligible_label | to_json }}
            - name: FLEET_ROLE_PINNED_LABEL
              value: {{ github_runner_arc_role_controller_pinned_label | to_json }}
            - name: FLEET_ROLE_LEVEL_LABEL
              value: {{ github_runner_arc_role_controller_level_label | to_json }}
            - name: FLEET_ROLE_STATE_NAMESPACE
              value: {{ namespace | to_json }}
            - name: FLEET_ROLE_PROBE_CONFIGMAP
              value: {{ probe_configmap | to_json }}
            - name: FLEET_ROLE_STATUS_CONFIGMAP
              value: {{ status_configmap | to_json }}
            # kubectl's cache goes to the in-memory volume, since the root filesystem is read-only.
            - name: HOME
              value: /tmp
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
              ephemeral-storage: {{ github_runner_arc_platform_ephemeral_storage_request | to_json }}
            limits:
              cpu: 200m
              memory: 128Mi
              ephemeral-storage: {{ github_runner_arc_platform_ephemeral_storage_limit | to_json }}
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir:
            medium: Memory
            sizeLimit: 8Mi
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: {{ probe | to_json }}
  namespace: {{ namespace | to_json }}
  labels: {{ (labels | combine({'app.kubernetes.io/name': probe})) | to_json }}
spec:
  selector:
    matchLabels: {{ {'app.kubernetes.io/name': probe} | to_json }}
  template:
    metadata:
      labels: {{ (labels | combine({'app.kubernetes.io/name': probe})) | to_json }}
    spec:
      serviceAccountName: {{ probe | to_json }}
      priorityClassName: {{ github_runner_arc_platform_priority_class_name | to_json }}
      # The host's network, so the probe measures the path the node's own etcd and kubelet use: on a node that runs in Docker, that is the k3s container's, where the node's Tailscale client lives. On a Docker node the k3s container also has the interfaces of its own network, which the probe reports as a link it cannot see.
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      nodeSelector: {{ {'kubernetes.io/os': 'linux'} | to_json }}
      # Every node with a kubelet, whatever it is tainted for; a server regraded to etcd-only has no kubelet, so no pod, and its side is read from its peers.
      tolerations:
        - operator: Exists
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: {{ probe | to_json }}
          image: {{ github_runner_arc_role_controller_image | to_json }}
          command: ["/app/scripts/fleet-role-probe.sh"]
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: NAMESPACE
              value: {{ namespace | to_json }}
            - name: ELECTION_TIMEOUT_MS
              value: {{ github_runner_arc_role_controller_election_timeout_ms | string | to_json }}
            - name: PROBE_CONFIGMAP
              value: {{ probe_configmap | to_json }}
            - name: REPORT_SECONDS
              value: {{ github_runner_arc_role_controller_sample_seconds | string | to_json }}
            - name: FSYNC_DIR
              value: /fsync
            # kubectl's cache goes to the in-memory volume, since the root filesystem is read-only.
            - name: HOME
              value: /tmp
          # Root, with every capability dropped, because the directory the kubelet creates on the node for the fdatasync reading belongs to root and a root without CAP_DAC_OVERRIDE writes only what it owns.
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
              ephemeral-storage: {{ github_runner_arc_platform_ephemeral_storage_request | to_json }}
            limits:
              cpu: 200m
              memory: 128Mi
              ephemeral-storage: {{ github_runner_arc_platform_ephemeral_storage_limit | to_json }}
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: pressure
              mountPath: /host-pressure
              readOnly: true
            - name: fsync
              mountPath: /fsync
      volumes:
        - name: tmp
          emptyDir:
            medium: Memory
            sizeLimit: 8Mi
        - name: pressure
          hostPath:
            path: /proc/pressure
        - name: fsync
          hostPath:
            path: {{ github_runner_arc_role_controller_data_dir | to_json }}
            type: DirectoryOrCreate
