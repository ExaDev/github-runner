RUNNER_SCOPE=org
ORG_NAME=ExaDev
APP_LOGIN=ExaDev
APP_ID=
# Paste the GitHub Apps private key PEM here. Multi-line PEM works fine inside a .env value
# if quoted, e.g.:
# APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# MIIEow...
# -----END RSA PRIVATE KEY-----"
APP_PRIVATE_KEY=
RUNNER_NAME_PREFIX=node-b-exadev
LABELS=self-hosted,linux,arm64,act-latest,node-b
EPHEMERAL=true
DISABLE_AUTO_UPDATE=true
