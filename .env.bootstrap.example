# Input for ./bootstrap.sh: copy to .env.bootstrap (gitignored) and fill in. bootstrap.sh turns these into variables for the Ansible role and runs it against this machine, so this file is only for a host brought up without an Ansible control node - inventory-managed hosts use ansible/host_vars/<host>.yml and 1Password instead. Not to be confused with .env, which the role itself generates on every run for docker-compose.yml.

# ---- k3s -------------------------------------------------------------------

# Arbitrary shared secret for node-join auth inside the k3s cluster, unrelated to GitHub (e.g. `openssl rand -hex 32`). The same value on every server/agent host.
K3S_TOKEN=

# A reusable, pre-authorized Tailscale auth key: k3s's own --vpn-auth integration runs Tailscale inside each node's k3s container with it. See the README's Tailscale section for how it's provisioned.
K3S_VPN_AUTH_JOIN_KEY=

# Optional: a Tailscale API token. When set, the role also ensures the tailnet's ACL grants cross-node pod traffic (see roles/github_runner_arc/tasks/ensure_tailscale.yml). Without it the ACL is left as it is.
TAILSCALE_API_TOKEN=

# Every server's own Tailscale hostname, space-separated, including this one's own (a single-server setup lists just its own). A multi-server cluster needs every server's cert to cover every server's name - see the README's Architecture section.
K3S_TLS_SAN_LIST=

# This host's k3s node name, which is also its Tailscale device hostname. Leave empty to use this machine's own short hostname.
K3S_NODE_NAME=

# Only on a server joining an EXISTING cluster: an already-running server's https://<address>:6443. Leave empty on the server that bootstraps the cluster.
K3S_JOIN_SERVER_URL=

# Only on a pure worker (agent) host: a server's https://<address>:6443. Setting this makes bootstrap.sh join as an agent instead of a server; K3S_AGENT_NODE_NAME replaces K3S_NODE_NAME for it.
K3S_AGENT_SERVER_URL=
K3S_AGENT_NODE_NAME=

# k3s image version (rancher/k3s tag). Empty means latest.
K3S_VERSION=

# ---- ExaDev runner scale set (leave EXADEV_APP_ID empty on a host that installs no org) ----

# ExaDev's GitHub App. The installation ID is resolved automatically from the App ID and key when left empty.
EXADEV_APP_ID=123456
EXADEV_APP_INSTALLATION_ID=
EXADEV_APP_PRIVATE_KEY_PATH=./secrets/example-app-private-key.pem

# A GHCR personal access token (read:packages scope) used to pull the private runner image and the fleet-health platform's own images.
GHCR_PULL_USERNAME=
GHCR_PULL_TOKEN=

# ---- Fleet-health platform (heartbeat + autoscaler) ----

# HEARTBEAT_GH_TOKEN is a GitHub PAT with `gist` scope, used to refresh the secret gist ExaDev/runner-fallback-action reads to decide self-hosted vs ubuntu-latest. Leave HEARTBEAT_GIST_ID empty on first run and the role creates the gist and stops, printing its id to put here.
HEARTBEAT_GH_TOKEN=
HEARTBEAT_GIST_ID=

# Optional overrides for the autoscaler's tunables - see scripts/autoscaler.sh and the README's Autoscaler section. Each defaults to the role's own value (roles/github_runner_arc/defaults/main.yml) when unset.
# AUTOSCALER_DRY_RUN=true
# AUTOSCALER_POLL_SECONDS=45
# AUTOSCALER_USABLE_BUDGET_GI=24
# AUTOSCALER_MAX_CEILING=7
# AUTOSCALER_FLOOR=3
# AUTOSCALER_RAISE_CONFIRM_POLLS=2
# AUTOSCALER_MEM_AVAILABLE_PRESSURE_PCT=15
