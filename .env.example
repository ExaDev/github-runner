# K3S_TOKEN: arbitrary shared secret for node-join auth inside the k3s
# cluster. Not related to GitHub in any way - generate any random string,
# e.g. `openssl rand -hex 32`. The same value on every server/agent host.
K3S_TOKEN=

# Every server's own Tailscale hostname (including this one's), space-separated -
# a multi-server cluster needs every server's cert to cover every server's own
# name, not just its own, since a client (kubectl) may reach any of them
# directly. Leave empty on a genuinely single-server setup nothing else ever
# joins. See the README's Architecture section.
K3S_TLS_SAN_LIST=

# Set on EVERY host (server or agent) once more than one host is in
# play: a reusable, pre-authorized Tailscale auth key. k3s's own built-in
# --vpn-auth integration uses this to run Tailscale INSIDE each node's
# own k3s container, joining the tailnet as its own device and using
# flannel's native "tailscale" backend for pod traffic - the host
# machine's own separately-running Tailscale client is not involved at
# all. See the README's Tailscale section for how this key is
# provisioned (a Tailscale API token, an ACL policy update, and the key
# itself). Leave empty on a genuinely single-host setup, where k3s's own
# default networking is correct.
K3S_VPN_AUTH_JOIN_KEY=

# Only set on a server host joining an EXISTING cluster: an already-running
# server's own https://<address>:6443. Leave empty on the one server that
# bootstraps the cluster (k3s --cluster-init).
K3S_JOIN_SERVER_URL=

# This host's own k3s node name/Tailscale hostname. Leave empty to default
# to this machine's own hostname; only needs setting to preserve a specific
# pre-existing device identity (see the README's Architecture section).
K3S_NODE_NAME=

# ExaDev's GitHub App (same one used to register the old myoung34-based
# fleet). APP_ID is public/non-secret; the installation ID and private key
# are used to build the Kubernetes Secret bootstrap.sh creates - never
# passed directly on the command line.
EXADEV_APP_ID=123456
EXADEV_APP_INSTALLATION_ID=
EXADEV_APP_PRIVATE_KEY_PATH=./secrets/example-app-private-key.pem

# A GHCR personal access token (read:packages scope) used to pull the
# private ghcr.io/exadev/github-runner image, plus the fleet-health
# platform's own images, into the cluster.
GHCR_PULL_USERNAME=
GHCR_PULL_TOKEN=

# Fleet-health platform (heartbeat + autoscaler - see bootstrap.sh's own
# install_platform, or ansible/roles/github_runner_arc/tasks/install_platform.yml
# under Ansible): HEARTBEAT_GH_TOKEN is a GitHub PAT with `gist` scope, used
# to refresh the secret gist that ExaDev/runner-fallback-action reads to
# decide self-hosted vs ubuntu-latest. Create the secret gist once with
# `gh gist create --filename arc-healthy-until -` (defaults to secret), then
# put its id (the hex tail of the gist URL) below. Only needed on the one
# host that installs the platform - leave both empty everywhere else.
HEARTBEAT_GH_TOKEN=
HEARTBEAT_GIST_ID=
# Optional overrides for the autoscaler's own tunables - see scripts/autoscaler.sh
# and the README's Autoscaler section for the full algorithm. Every one has a
# safe default in bootstrap.sh/install_platform.yml; only set here to override it.
# AUTOSCALER_DRY_RUN=true
# AUTOSCALER_POLL_SECONDS=45
# AUTOSCALER_USABLE_BUDGET_GI=24
# AUTOSCALER_MAX_CEILING=7
# AUTOSCALER_FLOOR=3
# AUTOSCALER_RAISE_CONFIRM_POLLS=2
# AUTOSCALER_MEM_AVAILABLE_PRESSURE_PCT=15

# Only set on a SECOND host joining as a k3s agent (worker only), never on
# a server host: `docker compose --profile agent up -d` instead of
# `--profile server`. K3S_AGENT_SERVER_URL is a server host's own
# address, e.g. https://<server-tailscale-hostname>:6443; K3S_TOKEN above
# must be the exact same value every other host's own .env uses. See the
# project README's Architecture section.
K3S_AGENT_SERVER_URL=
K3S_AGENT_NODE_NAME=
