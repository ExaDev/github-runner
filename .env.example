# K3S_TOKEN: arbitrary shared secret for node-join auth inside the k3s
# cluster. Not related to GitHub in any way - generate any random string,
# e.g. `openssl rand -hex 32`.
K3S_TOKEN=

# Only set on a primary host that a second host will join as a k3s agent:
# the externally-reachable address that agent connects through (e.g. a
# Tailscale MagicDNS name). k3s's self-signed cert only auto-includes its
# own container hostname/IPs and localhost, so this gets added as an
# extra --tls-san. Leave empty on a primary nothing else ever joins.
K3S_TLS_SAN=

# ExaDev's GitHub App (same one used to register the old myoung34-based
# fleet). APP_ID is public/non-secret; the installation ID and private key
# are used to build the Kubernetes Secret bootstrap.sh creates - never
# passed directly on the command line.
EXADEV_APP_ID=123456
EXADEV_APP_INSTALLATION_ID=
EXADEV_APP_PRIVATE_KEY_PATH=./secrets/example-app-private-key.pem

# A GHCR personal access token (read:packages scope) used to pull the
# private ghcr.io/exadev/github-runner image into the cluster.
GHCR_PULL_USERNAME=
GHCR_PULL_TOKEN=

# Heartbeat (the `heartbeat` compose service): a GitHub PAT with `gist` scope,
# used to refresh the secret gist that ExaDev/runner-fallback-action reads to
# decide self-hosted vs ubuntu-latest. Create the secret gist once with
# `gh gist create --filename arc-healthy-until -` (defaults to secret), then
# put its id (the hex tail of the gist URL) below.
HEARTBEAT_GH_TOKEN=
HEARTBEAT_GIST_ID=

# Only set on a SECOND host joining as a k3s agent (worker only), never on
# the primary host: `docker compose --profile agent up -d` instead of
# `--profile primary`. K3S_AGENT_SERVER_URL is the primary host's own
# address, e.g. https://<primary-tailscale-ip>:6443; K3S_TOKEN above must
# be the exact same value the primary's own .env uses. See the project
# README's Architecture section.
K3S_AGENT_SERVER_URL=
K3S_AGENT_NODE_NAME=
